# Bluney light — btop theme
# Install: cp btop/bluney-light.theme ~/.config/btop/themes/
# and set color_theme = "bluney-light" in btop.conf

theme[main_bg]="#F0F5FB"
theme[main_fg]="#1E2F45"
theme[title]="#1E2F45"
theme[hi_fg]="#2F6FB8"
theme[selected_bg]="#2F6FB8"
theme[selected_fg]="#F0F5FB"
theme[inactive_fg]="#5A6F8A"
theme[graph_text]="#1E2F45"
theme[meter_bg]="#E3EAF6"
theme[proc_misc]="#2F5E9E"
theme[cpu_box]="#5A6F8A"
theme[mem_box]="#1F7E9E"
theme[net_box]="#2F6FB8"
theme[proc_box]="#1F7E9E"
theme[div_line]="#E3EAF6"
theme[temp_start]="#2F6FB8"
