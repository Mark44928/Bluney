# Bluney dark — btop theme
# Install: cp btop/bluney-dark.theme ~/.config/btop/themes/
# and set color_theme = "bluney-dark" in btop.conf

theme[main_bg]="#0E1B2E"
theme[main_fg]="#D5E5F2"
theme[title]="#D5E5F2"
theme[hi_fg]="#7DBBFF"
theme[selected_bg]="#7DBBFF"
theme[selected_fg]="#0E1B2E"
theme[inactive_fg]="#7E9BB8"
theme[graph_text]="#D5E5F2"
theme[meter_bg]="#152A45"
theme[proc_misc]="#4F8FE0"
theme[cpu_box]="#7E9BB8"
theme[mem_box]="#7FD7F2"
theme[net_box]="#7DBBFF"
theme[proc_box]="#7FD7F2"
theme[div_line]="#152A45"
theme[temp_start]="#7DBBFF"
theme[temp_mid]="#E0CD97"
theme[temp_end]="#E18B8B"
theme[cpu_start]="#4F8FE0"
theme[cpu_mid]="#7DBBFF"
theme[cpu_end]="#E0CD97"
theme[free_start]="#7DBBFF"
theme[free_mid]="#A8D4FF"
theme[free_end]="#EBDFA8"
theme[cached_start]="#4F8FE0"
theme[cached_mid]="#7FA9E8"
theme[cached_end]="#A8E8F8"
theme[available_start]="#7DBBFF"
theme[available_mid]="#A8D4FF"
theme[available_end]="#EBDFA8"
