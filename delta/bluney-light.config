# Bluney light — git-delta color theme
# Include: [include] path = "$HOME/Bluney/delta/bluney-light.config"
# in ~/.gitconfig, then activate:
#   [delta] features = bluney-light
#
# Styles use git config color syntax: [attributes] foreground [background]
# or just "#RRGGBB" for foreground only. See git-config(1) color section.

[delta]
    dark = false
    light = true
    navigate = true
    line-numbers = true
    syntax-theme = Bluney light

[delta]
    commit-style = "#6B5AA8 bold"
    file-style = "#5A6F8A bold"
    file-decoration-style = "#5A6F8A" overline
    file-added-label = "[+]"
    file-modified-label = "[~]"
    file-removed-label = "[-]"
    file-renamed-label = "[→]"
    hunk-header-style = "#2F5E9E bold italic"
    minus-style = "#AE4A42"
    minus-emph-style = "#AE4A42" bold
    plus-style = "#2F6FB8"
    plus-emph-style = "#2F6FB8" bold
    zero-style = "#5A6F8A"
    whitespace-error-style = "#AE4A42" reverse
    syntax-theme = Bluney light
