# Bluney dark — git-delta color theme
# Include: [include] path = "$HOME/Bluney/delta/bluney-dark.config"
# in ~/.gitconfig, then activate:
#   [delta] features = bluney-dark
#
# Styles use git config color syntax: [attributes] foreground [background]
# or just "#RRGGBB" for foreground only. See git-config(1) color section.

[delta]
    dark = true
    light = false
    navigate = true
    line-numbers = true
    syntax-theme = Bluney dark

[delta]
    commit-style = "#B9A8E0 bold"
    file-style = "#7E9BB8 bold"
    file-decoration-style = "#7E9BB8" overline
    file-added-label = "[+]"
    file-modified-label = "[~]"
    file-removed-label = "[-]"
    file-renamed-label = "[→]"
    hunk-header-style = "#4F8FE0 bold italic"
    minus-style = "#E18B8B"
    minus-emph-style = "#E18B8B" bold
    plus-style = "#7DBBFF"
    plus-emph-style = "#7DBBFF" bold
    zero-style = "#7E9BB8"
    whitespace-error-style = "#E18B8B" reverse
    syntax-theme = Bluney dark
