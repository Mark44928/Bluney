# Bluney light — git color configuration
# Include: [include] path = "$HOME/Bluney/git/bluney-light.config"
# in ~/.gitconfig, or append these sections directly.
# Hex #RRGGBB values supported by git ≥ 2.26.

[color]
    ui = always
    diff = always
    status = always
    branch = always
    grep = always
    decorate = always
    interactive = always
    pager = true

[color "diff"]
    meta = "#2F5E9E bold"
    frag = "#6B5AA8 bold"
    func = "#1B6E8A"
    context = "#5A6F8A"
    old = "#AE4A42 bold"
    new = "#2F6FB8 bold"
    commit = "#7A5F1A"
    whitespace = "#AE4A42 reverse"

[color "status"]
    header = "#1E2F45 bold"
    added = "#2F6FB8"
    changed = "#7A5F1A"
    untracked = "#6B5AA8"
    branch = "#2F5E9E bold"
    nobranch = "#AE4A42 reverse"

[color "branch"]
    current = "#2F6FB8 bold"
    local = "#1E2F45"
    remote = "#2F5E9E"
    upstream = "#6B5AA8"
    plain = "#1E2F45"

[color "decorate"]
    branch = "#1B6E8A"
    remoteBranch = "#2F5E9E"
    tag = "#6B5AA8"
    stash = "#7A5F1A"
    HEAD = "#5A6F8A"

[color "grep"]
    filename = "#6B5AA8"
    linenumber = "#2F5E9E"
    match = "#2F6FB8 bold"
    matchContext = "#1E2F45"
    separator = "#5A6F8A"

[color "interactive"]
    prompt = "#2F6FB8 bold"
    header = "#1E2F45"
    help = "#5A6F8A"
    error = "#AE4A42"
