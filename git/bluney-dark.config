# Bluney dark — git color configuration
# Include: [include] path = "$HOME/Bluney/git/bluney-dark.config"
# in ~/.gitconfig, or append these sections directly.
# Hex #RRGGBB values supported by git ≥ 2.26.

[color]
    ui = always
    diff = always
    status = always
    branch = always
    grep = always
    decorate = always
    interactive = always
    pager = true

[color "diff"]
    meta = "#4F8FE0 bold"
    frag = "#B9A8E0 bold"
    func = "#7FD7F2"
    context = "#7E9BB8"
    old = "#E18B8B bold"
    new = "#7DBBFF bold"
    commit = "#E0CD97"
    whitespace = "#E18B8B reverse"

[color "status"]
    header = "#D5E5F2 bold"
    added = "#7DBBFF"
    changed = "#E0CD97"
    untracked = "#B9A8E0"
    branch = "#4F8FE0 bold"
    nobranch = "#E18B8B reverse"

[color "branch"]
    current = "#7DBBFF bold"
    local = "#D5E5F2"
    remote = "#4F8FE0"
    upstream = "#B9A8E0"
    plain = "#D5E5F2"

[color "decorate"]
    branch = "#7FD7F2"
    remoteBranch = "#4F8FE0"
    tag = "#B9A8E0"
    stash = "#E0CD97"
    HEAD = "#7E9BB8"

[color "grep"]
    filename = "#B9A8E0"
    linenumber = "#4F8FE0"
    match = "#7DBBFF bold"
    matchContext = "#D5E5F2"
    separator = "#7E9BB8"

[color "interactive"]
    prompt = "#7DBBFF bold"
    header = "#D5E5F2"
    help = "#7E9BB8"
    error = "#E18B8B"
