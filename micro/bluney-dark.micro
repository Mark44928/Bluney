# Bluney dark — micro color scheme
# Install: cp micro/bluney-dark.micro ~/.config/micro/colorschemes/
# Then in micro: set colorscheme bluney-dark

color-link default "#D5E5F2,#0E1B2E"
color-link comment "#7E9BB8"
color-link identifier "#7DBBFF"
color-link constant "#4F8FE0"
color-link constant.string "#E0CD97"
color-link statement "bold #7FD7F2"
color-link symbol "#D5E5F2"
color-link symbol.operator "#E0CD97"
color-link preproc "#B9A8E0"
color-link type "#7FD7F2"
color-link special "#4F8FE0"
color-link underlined "#B9A8E0"
color-link error "bold #E18B8B"
color-link todo "bold #B9A8E0"
color-link selection "#D5E5F2,#152A45"
color-link statusline "#D5E5F2,#152A45"
color-link statusline.inactive "#7E9BB8,#0E1B2E"
color-link statusline.suggestions "#D5E5F2,#152A45"
color-link tabbar "#D5E5F2,#152A45"
color-link tabbar.active "#0E1B2E,#7DBBFF"
color-link indent-char "#7E9BB8"
color-link line-number "#7E9BB8"
color-link current-line-number "#7DBBFF"
color-link gutter-info "#7FD7F2"
color-link gutter-error "#E18B8B"
color-link gutter-warning "#E0CD97"
color-link diff-added "#7DBBFF"
color-link diff-modified "#E0CD97"
color-link diff-deleted "#E18B8B"
color-link cursor-line "#152A45"
color-link color-column "#152A45"
color-link message "#4F8FE0"
color-link error-message "#E18B8B"
color-link match-brace "#7DBBFF"
color-link hlsearch "#E0CD97,#152A45"
color-link tab-error "#E18B8B"
color-link trailingws "#E18B8B"
color-link ignore "default"
color-link type.extended "default"
