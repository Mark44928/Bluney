# Bluney light — micro color scheme
# Install: cp micro/bluney-light.micro ~/.config/micro/colorschemes/
# Then in micro: set colorscheme bluney-light

color-link default "#1E2F45,#F0F5FB"
color-link comment "#5A6F8A"
color-link identifier "#2F6FB8"
color-link constant "#2F5E9E"
color-link constant.string "#7A5F1A"
color-link statement "bold #1B6E8A"
color-link symbol "#1E2F45"
color-link symbol.operator "#7A5F1A"
color-link preproc "#6B5AA8"
color-link type "#1B6E8A"
color-link special "#2F5E9E"
color-link underlined "#6B5AA8"
color-link error "bold #AE4A42"
color-link todo "bold #6B5AA8"
color-link selection "#1E2F45,#E3EAF6"
color-link statusline "#1E2F45,#E3EAF6"
color-link statusline.inactive "#5A6F8A,#F0F5FB"
color-link statusline.suggestions "#1E2F45,#E3EAF6"
color-link tabbar "#1E2F45,#E3EAF6"
color-link tabbar.active "#F0F5FB,#2F6FB8"
color-link indent-char "#5A6F8A"
color-link line-number "#5A6F8A"
color-link current-line-number "#2F6FB8"
color-link gutter-info "#1B6E8A"
color-link gutter-error "#AE4A42"
color-link gutter-warning "#7A5F1A"
color-link diff-added "#2F6FB8"
color-link diff-modified "#7A5F1A"
color-link diff-deleted "#AE4A42"
color-link cursor-line "#E3EAF6"
color-link color-column "#E3EAF6"
color-link message "#2F5E9E"
color-link error-message "#AE4A42"
color-link match-brace "#2F6FB8"
color-link hlsearch "#7A5F1A,#E3EAF6"
color-link tab-error "#AE4A42"
color-link trailingws "#AE4A42"
color-link ignore "default"
color-link type.extended "default"
