# Bluney dark — Powerlevel10k prompt theme
# Source: source "$HOME/Bluney/powerlevel10k/bluney-dark.zsh"
# in ~/.p10k.zsh, or add to ~/.zshrc after p10k is loaded.
# Hex #RRGGBB values are supported by Powerlevel10k.

typeset -g POWERLEVEL9K_BACKGROUND=
typeset -g POWERLEVEL9K_FOREGROUND="#D5E5F2"

# Context (user@hostname)
typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND="#D5E5F2"
typeset -g POWERLEVEL9K_CONTEXT_BACKGROUND="#152A45"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND="#E18B8B"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_BACKGROUND="#152A45"

# Directory
typeset -g POWERLEVEL9K_DIR_FOREGROUND="#D5E5F2"
typeset -g POWERLEVEL9K_DIR_BACKGROUND="#0E1B2E"
typeset -g POWERLEVEL9K_DIR_HOME_FOREGROUND="#D5E5F2"
typeset -g POWERLEVEL9K_DIR_HOME_BACKGROUND="#0E1B2E"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND="#D5E5F2"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_BACKGROUND="#0E1B2E"
typeset -g POWERLEVEL9K_DIR_ETC_FOREGROUND="#4F8FE0"
typeset -g POWERLEVEL9K_DIR_ETC_BACKGROUND="#0E1B2E"

# VCS (git)
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND="#7DBBFF"
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND="#0E1B2E"
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND="#E0CD97"
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND="#0E1B2E"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND="#4F8FE0"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND="#0E1B2E"
typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND="#7E9BB8"
typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND="#0E1B2E"

# Status (exit code)
typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND="#7DBBFF"
typeset -g POWERLEVEL9K_STATUS_OK_BACKGROUND="#0E1B2E"
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND="#E18B8B"
typeset -g POWERLEVEL9K_STATUS_ERROR_BACKGROUND="#0E1B2E"

# Prompt char
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#7DBBFF"
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#E18B8B"
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=

# Time
typeset -g POWERLEVEL9K_TIME_FOREGROUND="#7E9BB8"
typeset -g POWERLEVEL9K_TIME_BACKGROUND="#0E1B2E"

# Command execution time
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND="#4F8FE0"
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND="#0E1B2E"

# Background jobs
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND="#B9A8E0"
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_BACKGROUND="#0E1B2E"

# Root indicator
typeset -g POWERLEVEL9K_ROOT_INDICATOR_FOREGROUND="#E18B8B"
typeset -g POWERLEVEL9K_ROOT_INDICATOR_BACKGROUND="#0E1B2E"

# Dir writable
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_FOREGROUND="#E18B8B"
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_BACKGROUND="#0E1B2E"

# Separators
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR='\uE0B0'
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR='\uE0B2'
typeset -g POWERLEVEL9K_LEFT_SUBSEGMENT_SEPARATOR='\uE0B1'
typeset -g POWERLEVEL9K_RIGHT_SUBSEGMENT_SEPARATOR='\uE0B3'
