# Bluney light — Powerlevel10k prompt theme
# Source: source "$HOME/Bluney/powerlevel10k/bluney-light.zsh"
# in ~/.p10k.zsh, or add to ~/.zshrc after p10k is loaded.
# Hex #RRGGBB values are supported by Powerlevel10k.

typeset -g POWERLEVEL9K_BACKGROUND=
typeset -g POWERLEVEL9K_FOREGROUND="#1E2F45"

# Context (user@hostname)
typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND="#1E2F45"
typeset -g POWERLEVEL9K_CONTEXT_BACKGROUND="#E3EAF6"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND="#AE4A42"
typeset -g POWERLEVEL9K_CONTEXT_ROOT_BACKGROUND="#E3EAF6"

# Directory
typeset -g POWERLEVEL9K_DIR_FOREGROUND="#1E2F45"
typeset -g POWERLEVEL9K_DIR_BACKGROUND="#F0F5FB"
typeset -g POWERLEVEL9K_DIR_HOME_FOREGROUND="#1E2F45"
typeset -g POWERLEVEL9K_DIR_HOME_BACKGROUND="#F0F5FB"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND="#1E2F45"
typeset -g POWERLEVEL9K_DIR_HOME_SUBFOLDER_BACKGROUND="#F0F5FB"
typeset -g POWERLEVEL9K_DIR_ETC_FOREGROUND="#2F5E9E"
typeset -g POWERLEVEL9K_DIR_ETC_BACKGROUND="#F0F5FB"

# VCS (git)
typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND="#2F6FB8"
typeset -g POWERLEVEL9K_VCS_CLEAN_BACKGROUND="#F0F5FB"
typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND="#7A5F1A"
typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND="#F0F5FB"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND="#2F5E9E"
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND="#F0F5FB"
typeset -g POWERLEVEL9K_VCS_LOADING_FOREGROUND="#5A6F8A"
typeset -g POWERLEVEL9K_VCS_LOADING_BACKGROUND="#F0F5FB"

# Status (exit code)
typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND="#2F6FB8"
typeset -g POWERLEVEL9K_STATUS_OK_BACKGROUND="#F0F5FB"
typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND="#AE4A42"
typeset -g POWERLEVEL9K_STATUS_ERROR_BACKGROUND="#F0F5FB"

# Prompt char
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#2F6FB8"
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND="#AE4A42"
typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=
typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_BACKGROUND=

# Time
typeset -g POWERLEVEL9K_TIME_FOREGROUND="#5A6F8A"
typeset -g POWERLEVEL9K_TIME_BACKGROUND="#F0F5FB"

# Command execution time
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND="#2F5E9E"
typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_BACKGROUND="#F0F5FB"

# Background jobs
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND="#6B5AA8"
typeset -g POWERLEVEL9K_BACKGROUND_JOBS_BACKGROUND="#F0F5FB"

# Root indicator
typeset -g POWERLEVEL9K_ROOT_INDICATOR_FOREGROUND="#AE4A42"
typeset -g POWERLEVEL9K_ROOT_INDICATOR_BACKGROUND="#F0F5FB"

# Dir writable
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_FOREGROUND="#AE4A42"
typeset -g POWERLEVEL9K_DIR_WRITABLE_JOINT_BACKGROUND="#F0F5FB"

# Separators
typeset -g POWERLEVEL9K_LEFT_SEGMENT_SEPARATOR='\uE0B0'
typeset -g POWERLEVEL9K_RIGHT_SEGMENT_SEPARATOR='\uE0B2'
typeset -g POWERLEVEL9K_LEFT_SUBSEGMENT_SEPARATOR='\uE0B1'
typeset -g POWERLEVEL9K_RIGHT_SUBSEGMENT_SEPARATOR='\uE0B3'
