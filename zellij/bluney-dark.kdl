# Bluney dark — zellij theme
# Install: mkdir -p ~/.config/zellij/themes && cp zellij/bluney-dark.kdl ~/.config/zellij/themes/
# Load: theme "bluney-dark" in ~/.config/zellij/config.kdl
# Colors use #RRGGBB hex format.

themes {
	bluney-dark {
		fg "#D5E5F2"
		bg "#0E1B2E"
		black "#7E9BB8"
		red "#E18B8B"
		green "#7DBBFF"
		yellow "#E0CD97"
		blue "#4F8FE0"
		magenta "#B9A8E0"
		cyan "#7FD7F2"
		white "#D5E5F2"
		orange "#E18B8B"
	}

	bluney-dark-syntax {
		fg "#D5E5F2"
		bg "#0E1B2E"
		black "#7E9BB8"
		red "#B9A8E0"
		green "#7DBBFF"
		yellow "#E0CD97"
		blue "#7FD7F2"
		magenta "#4F8FE0"
		cyan "#7DBBFF"
		white "#D5E5F2"
		orange "#E18B8B"
	}
}
