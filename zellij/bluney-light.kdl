# Bluney light — zellij theme
# Install: mkdir -p ~/.config/zellij/themes && cp zellij/bluney-light.kdl ~/.config/zellij/themes/
# Load: theme "bluney-light" in ~/.config/zellij/config.kdl
# Colors use #RRGGBB hex format.

themes {
	bluney-light {
		fg "#1E2F45"
		bg "#F0F5FB"
		black "#5A6F8A"
		red "#AE4A42"
		green "#2F6FB8"
		yellow "#7A5F1A"
		blue "#2F5E9E"
		magenta "#6B5AA8"
		cyan "#1B6E8A"
		white "#1E2F45"
		orange "#AE4A42"
	}

	bluney-light-syntax {
		fg "#1E2F45"
		bg "#F0F5FB"
		black "#5A6F8A"
		red "#6B5AA8"
		green "#2F6FB8"
		yellow "#7A5F1A"
		blue "#1B6E8A"
		magenta "#2F5E9E"
		cyan "#2F6FB8"
		white "#1E2F45"
		orange "#AE4A42"
	}
}
