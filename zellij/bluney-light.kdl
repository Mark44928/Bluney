# Bluney light — zellij theme
# Install: mkdir -p ~/.config/zellij/themes && cp zellij/bluney-light.kdl ~/.config/zellij/themes/
# Load: theme "bluney-light" in ~/.config/zellij/config.kdl
# Colors use #RRGGBB hex format.

themes {
	bluney-light {
		fg "#1E2F45"
		bg "#F0F5FB"
		black "#5A6F8A"
		red "#C0574E"
		green "#2F6FB8"
		yellow "#8A6D1F"
		blue "#2F5E9E"
		magenta "#6B5AA8"
		cyan "#1F7E9E"
		white "#1E2F45"
		orange "#C0574E"
	}

	bluney-light-syntax {
		fg "#1E2F45"
		bg "#F0F5FB"
		black "#5A6F8A"
		red "#6B5AA8"
		green "#2F6FB8"
		yellow "#8A6D1F"
		blue "#1F7E9E"
		magenta "#2F5E9E"
		cyan "#2F6FB8"
		white "#1E2F45"
		orange "#C0574E"
	}
}
